{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tax Evidence Pack",
  "version": "0.1.2",
  "identifier": "in.sociobot.tax-evidence-pack",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist/app" },
  "app": { "windows": [{ "title": "Tax Evidence Pack", "width": 1180, "height": 760, "minWidth": 390, "minHeight": 620 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;" } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
